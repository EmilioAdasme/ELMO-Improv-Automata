, 			{
				"box" : 				{
					"code" : "// in1  = caos (0..1) — la única variable\n// out1 = envolvente (0..1), multiplícala por la salida del drone\n// out2 = trigger de 1 muestra en cada evento audible\n// out3 = rampa cruda del evento (para otras formas)\n// out4 = duración del ciclo actual en ms\n// out5 = compuerta por envolvente: 1 en la primera mitad de cada paso audible\n\nParam base_ms(1500, min=5);\nParam octavas(2, min=0);\nParam ataque(0.08, min=0.001, max=0.99);\nParam curva(2.5, min=0.1);\n\nHistory ph(1);\nHistory inc(0);\nHistory n(1);\nHistory abierto(1);\nHistory r_prev(0);\nHistory dur(1500);\n\nc = clamp(in1, 0, 1);\nu1 = 0; u2 = 0; d = 0; w = 0; pois = 0; psub = 0;\n\n// reloj de ciclo con período variable \nph = ph + inc;\nif (ph >= 1) {\n    ph = wrap(ph, 0, 1);\n\n    // 1) duración log-normal: desvío en octavas escalado por caos\n    d = base_ms * pow(2, noise() * c * octavas);\n\n    // 2) sobre caos 0.6, fundido hacia intervalos de Poisson\n    u1 = max((noise() + 1) * 0.5, 0.0001);\n    pois = base_ms * -log(u1);\n    w = clamp((c - 0.6) / 0.4, 0, 1);\n    d = mix(d, pois, w);\n\n    // 3) subdivisión probabilística, máxima en caos = 0.5\n    psub = 4 * c * (1 - c);\n    u2 = (noise() + 1) * 0.5;\n    if (u2 < psub) {\n        n = floor((noise() + 1) * 0.5 * 3.999) + 2;   // 2..5\n    } else {\n        n = 1;\n    }\n\n    dur = max(d, 5);\n    inc = 1 / mstosamps(dur);\n}\n\n// sub-rampa y decisión de silencio por pulso\nr = wrap(ph * n, 0, 1);\ntrig = 0;\nif (r < r_prev) {\n    abierto = ((noise() + 1) * 0.5) >= (c * c * 0.7);\n    trig = abierto;\n}\nr_prev = r;\n\n// forma de envolvente relativa a la duración\nenv = r < ataque ? r / ataque : pow(1 - (r - ataque) / (1 - ataque), curva);\n\n// compuerta para generar bangs afuera\ncompuerta = abierto * (r < 0.5);\n\nout1 = env * abierto;\nout2 = trig;\nout3 = r;\nout4 = dur;\nout5 = compuerta;",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-5",
					"maxclass" : "codebox",
					"numinlets" : 1,
					"numoutlets" : 5,
					"outlettype" : [ "", "", "", "", "" ],
					"patching_rect" : [ 73.0, 129.0, 607.0, 558.0 ]
				}

			}
